# SQL Server remoto. Mantenga el valor entre comillas simples para evitar
# que Docker Compose interprete caracteres especiales de la contraseña.
TALLERES_CONNECTION_STRING='Server=sql.example.com,1433;Database=Talleres;Integrated Security=False;User ID=usuario;Password=clave;Encrypt=True;TrustServerCertificate=False'

# Conexión de solo lectura lógico a la base de SMART TPV NOVA. La cuenta SQL
# debe limitarse a consultar AspNetUsers y Empresa.
SMART_NOVA_CONNECTION_STRING='Server=sql.example.com,1433;Database=Galileo;Integrated Security=False;User ID=usuario_lectura;Password=clave;Encrypt=True;TrustServerCertificate=False'

# Habilite migraciones remotas únicamente de manera deliberada.
TALLERES_APLICAR_MIGRACIONES=false

# Use true cuando el sitio se publique exclusivamente mediante HTTPS.
TALLERES_COOKIE_SEGURA=false

# Proveedores de inicio de sesión externo (no publique estos secretos).
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
MICROSOFT_CLIENT_ID=''
MICROSOFT_CLIENT_SECRET=''

# Permite abrir el frontal desde una tablet de la red local. En Coolify use
# 127.0.0.1 o deje que compose.yaml aplique ese valor seguro por defecto.
TALLERES_WEB_IP_PUBLICACION=0.0.0.0
TALLERES_WEB_PORT=3000
