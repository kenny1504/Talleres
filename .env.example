# SQL Server remoto. Mantenga el valor entre comillas simples para evitar
# que Docker Compose interprete caracteres especiales de la contraseña.
TALLERES_CONNECTION_STRING='Server=sql.example.com,1433;Database=Talleres;Integrated Security=False;User ID=usuario;Password=clave;Encrypt=True;TrustServerCertificate=False'

# Habilite migraciones remotas únicamente de manera deliberada.
TALLERES_APLICAR_MIGRACIONES=false

TALLERES_EMPRESA_ID=1
TALLERES_API_PORT=8080
TALLERES_WEB_PORT=3000
