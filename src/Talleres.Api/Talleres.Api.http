@Talleres_Api_HostAddress = http://localhost:5056
@UsuarioNova = usuario@example.com
@ContrasenaNova = cambie-esta-clave

GET {{Talleres_Api_HostAddress}}/salud
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/autenticacion/iniciar
Content-Type: application/json

{
  "usuario": "{{UsuarioNova}}",
  "contrasena": "{{ContrasenaNova}}",
  "recordarme": false
}

###

GET {{Talleres_Api_HostAddress}}/api/autenticacion/sesion
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/clientes
Content-Type: application/json

{
  "nombre": "Ana López",
  "telefono": "8888-0000",
  "direccion": "Managua"
}

###

GET {{Talleres_Api_HostAddress}}/api/clientes
Accept: application/json

###

GET {{Talleres_Api_HostAddress}}/api/clientes/1/estado-cuenta
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/clientes/1/pagos
Content-Type: application/json

{
  "monto": 500.00
}

###

POST {{Talleres_Api_HostAddress}}/api/clientes/1/pagos/1/anular

###

GET {{Talleres_Api_HostAddress}}/api/vehiculos
Accept: application/json

###

GET {{Talleres_Api_HostAddress}}/api/tecnicos-taller
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/tecnicos-taller
Content-Type: application/json

{
  "nombre": "Carlos Pérez",
  "esPredeterminado": true
}

###

PUT {{Talleres_Api_HostAddress}}/api/tecnicos-taller/1
Content-Type: application/json

{
  "nombre": "Carlos Pérez",
  "activo": true
}

###

PUT {{Talleres_Api_HostAddress}}/api/tecnicos-taller/1/predeterminado

###

PUT {{Talleres_Api_HostAddress}}/api/ordenes-servicio/1/tecnico
Content-Type: application/json

{
  "tecnicoTallerId": 1
}

###

POST {{Talleres_Api_HostAddress}}/api/ordenes-servicio
Content-Type: application/json

{
  "clienteId": 1,
  "vehiculoId": 1,
  "observaciones": "Revisión general",
  "tecnicoTallerId": 1
}

###

POST {{Talleres_Api_HostAddress}}/api/catalogos-vehiculos/marcas
Content-Type: application/json

{
  "nombre": "Toyota",
  "activa": true
}

###

POST {{Talleres_Api_HostAddress}}/api/catalogos-vehiculos/modelos
Content-Type: application/json

{
  "marcaVehiculoId": 1,
  "nombre": "Hilux",
  "activo": true
}

###

POST {{Talleres_Api_HostAddress}}/api/vehiculos
Content-Type: application/json

{
  "clienteId": 1,
  "placa": "M 245-781",
  "modeloVehiculoId": 1,
  "anio": 2025,
  "color": "Blanco",
  "numeroVin": "VIN-EJEMPLO-001"
}

###

PUT {{Talleres_Api_HostAddress}}/api/vehiculos/1
Content-Type: application/json

{
  "clienteId": 1,
  "placa": "M 245-781",
  "modeloVehiculoId": 1,
  "anio": 2025,
  "color": "Gris",
  "numeroVin": "VIN-EJEMPLO-001",
  "activo": true
}
