@Talleres_Api_HostAddress = http://localhost:5056
@UsuarioNova = usuario@example.com
@ContrasenaNova = cambie-esta-clave
@OrdenServicioId = 1

### Iniciar reparación desde el taller (requiere sesión y diagnóstico guardado).
# Admite Diagnostico, Cotizacion, PendienteAprobacion y PreparacionReparacion.
# No requiere autorización digital ni modifica fechaAutorizacionClienteUtc.
# El servidor registra en el historial si existía autorización digital del cliente.
PUT {{Talleres_Api_HostAddress}}/api/ordenes-servicio/{{OrdenServicioId}}/estado
Content-Type: application/json

{
  "estado": "Reparacion",
  "descripcion": "Reparación iniciada desde el taller."
}

### Estado del negocio (requiere la cookie de sesión del taller activo).
# Fechas locales inclusivas; 360 corresponde a UTC-6. Máximo 366 días.
# agrupacion admite Dia, Semana o Mes. La cartera siempre muestra el saldo actual completo.
GET {{Talleres_Api_HostAddress}}/api/estado-negocio?desde=2026-10-01&hasta=2026-10-14&desfaseHorarioMinutos=360&agrupacion=Dia

###

GET {{Talleres_Api_HostAddress}}/salud
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/autenticacion/iniciar
Content-Type: application/json

{
  "usuario": "{{UsuarioNova}}",
  "contrasena": "{{ContrasenaNova}}",
  "recordarme": false
}

###

GET {{Talleres_Api_HostAddress}}/api/autenticacion/sesion
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/clientes
Content-Type: application/json

{
  "nombre": "Ana López",
  "telefono": "8888-0000",
  "direccion": "Managua"
}

###

GET {{Talleres_Api_HostAddress}}/api/clientes
Accept: application/json

###

# Cada orden incluye placaVehiculo, marcaVehiculo, modeloVehiculo y anioVehiculo.
GET {{Talleres_Api_HostAddress}}/api/clientes/1/estado-cuenta
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/clientes/1/pagos
Content-Type: application/json

{
  "monto": 500.00
}

###

POST {{Talleres_Api_HostAddress}}/api/clientes/1/pagos/1/anular

###

GET {{Talleres_Api_HostAddress}}/api/vehiculos
Accept: application/json

###

GET {{Talleres_Api_HostAddress}}/api/tecnicos-taller
Accept: application/json

###

POST {{Talleres_Api_HostAddress}}/api/tecnicos-taller
Content-Type: application/json

{
  "nombre": "Carlos Pérez",
  "esPredeterminado": true
}

###

PUT {{Talleres_Api_HostAddress}}/api/tecnicos-taller/1
Content-Type: application/json

{
  "nombre": "Carlos Pérez",
  "activo": true
}

### Recepción: usar una orden nueva que aún esté en recepción.
# descripcionEstado es opcional (máximo 2000 caracteres): se puede omitir, enviar null o "".
# revisionOperativa incluye solo actividades revisadas; correcto=true equivale a ✓ y false a ✕.

POST {{Talleres_Api_HostAddress}}/api/ordenes-servicio/{{OrdenServicioId}}/recepcion
Content-Type: application/json

{
  "kilometraje": 65000,
  "porcentajeCombustible": 50,
  "descripcionEstado": "Vehículo recibido para revisión general.",
  "revisionOperativa": [
    { "actividad": "LucesDelanteras", "correcto": true },
    { "actividad": "Bocina", "correcto": false }
  ],
  "observacionRevisionOperativa": "La bocina no funciona.",
  "dejaLlaves": true,
  "dejaDocumentos": true,
  "dejaLlantaRepuesto": true,
  "dejaTrianguloSeguridad": true,
  "dejaGata": true,
  "dejaLlaveRuedas": true,
  "dejaGanchoRemolque": false,
  "dejaExtintor": true,
  "dejaBotiquin": false,
  "dejaChalecoReflectante": false,
  "otrosElementos": "Llave de seguridad de ruedas",
  "aceptaPruebaRuta": true,
  "danios": []
}

### Consultar todos los elementos y hallazgos persistidos.

GET {{Talleres_Api_HostAddress}}/api/ordenes-servicio/{{OrdenServicioId}}/recepcion
Accept: application/json

### Corregir la inspección: enviar el conjunto completo, incluidos los hallazgos existentes.
# Para quitar la observación general, enviar descripcionEstado como "" o null.
# Enviar revisionOperativa completa y su observación para corregirlas; [] deja todos los puntos sin revisar.
# Omitir revisionOperativa conserva la revisión y su observación anteriores.

PUT {{Talleres_Api_HostAddress}}/api/ordenes-servicio/{{OrdenServicioId}}/recepcion
Content-Type: application/json

{
  "kilometraje": 65000,
  "porcentajeCombustible": 50,
  "descripcionEstado": "Vehículo recibido para revisión general.",
  "revisionOperativa": [
    { "actividad": "LucesDelanteras", "correcto": true },
    { "actividad": "Bocina", "correcto": true }
  ],
  "observacionRevisionOperativa": "Se verificó nuevamente la bocina y funciona correctamente.",
  "dejaLlaves": true,
  "dejaDocumentos": true,
  "dejaLlantaRepuesto": true,
  "dejaTrianguloSeguridad": true,
  "dejaGata": true,
  "dejaLlaveRuedas": true,
  "dejaGanchoRemolque": false,
  "dejaExtintor": true,
  "dejaBotiquin": true,
  "dejaChalecoReflectante": false,
  "otrosElementos": "Llave de seguridad de ruedas y cables de arranque",
  "aceptaPruebaRuta": true,
  "danios": []
}

